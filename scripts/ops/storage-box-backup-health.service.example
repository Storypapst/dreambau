[Unit]
Description=Check encrypted application backup freshness
OnFailure=storage-box-backup-failure@%n.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/storage-box-backup/storage-box-backup.py check-health --config /etc/storage-box-backup/backup.json --max-age-hours 30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
