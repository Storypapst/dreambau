[Unit]
Description=Evidence scheduled maintenance through the existing gateway container
Wants=network-online.target
After=network-online.target docker.service
# The companion handler records failures locally; it sends no external messages.
OnFailure=storage-box-backup-failure@%n.service

[Service]
Type=oneshot
User=root
UMask=0077
# This file holds only reviewed absolute Compose paths and a service name, not credentials.
EnvironmentFile=/etc/storage-box-backup/evidence-maintenance.env
WorkingDirectory=/
# Reuse the running service's existing secret mounts. There is no separate maintenance service.
ExecStart=/usr/bin/flock -w 3600 ${EVIDENCE_DATA_LOCK} /usr/bin/docker compose -f ${EVIDENCE_COMPOSE_FILE} exec -T ${EVIDENCE_COMPOSE_SERVICE} node dist/evidence/server/maintenance.js all
TimeoutStartSec=1h
KillMode=control-group
NoNewPrivileges=true
