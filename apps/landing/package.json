{
  "name": "dreambau-landing",
  "version": "1.0.0",
  "private": true,
  "description": "dreambau.com landing page: three procedural audiovisual productions, one of them picked at random on every load",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:dev": "node tools/build.mjs --dev",
    "verify": "node tools/verify.mjs",
    "serve": "node tools/serve.mjs",
    "bundle": "node tools/bundle.mjs",
    "build:apex": "node tools/build-apex.mjs",
    "check:apex": "node tools/apex-check.mjs",
    "e2e": "node tools/e2e.mjs all",
    "e2e:lang": "node tools/e2e-lang.mjs",
    "test:languages": "node --test tools/lang-tests/*.mjs",
    "sync:languages": "node tools/sync-languages.mjs",
    "build:languages": "node tools/build-languages.mjs",
    "check:languages": "node tools/check-languages.mjs",
    "sheet:languages": "node tools/lang-sheet.mjs",
    "check:nginx": "node tools/nginx-check.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.56.1"
  }
}
