{
  "name": "ORISO Work State Sources",
  "url": "https://dreambau.com/testmails/",
  "public": false,
  "hook_attributes": {
    "url": "https://dreambau.com/testmails/api/work-state/webhook",
    "active": true
  },
  "default_permissions": {
    "metadata": "read",
    "pull_requests": "read",
    "checks": "read",
    "statuses": "read",
    "issues": "read",
    "organization_projects": "read"
  },
  "default_events": [
    "pull_request",
    "pull_request_review",
    "pull_request_review_thread",
    "check_run",
    "check_suite",
    "status"
  ]
}
